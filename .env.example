# ==============================================================================
# FairShift Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production

# Application Secret Key for JWT Signature (Generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string

# Database Connection URL (Cloud SQL PostgreSQL or Local PostgreSQL)
# Example: postgresql://fs_user:your_password@127.0.0.1:5432/fairshift_db
DATABASE_URL=sqlite:///./fairshift.db

# Cloud Run Port (Injected automatically by Google Cloud Run)
PORT=8080

# Cross-Origin Resource Sharing (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
